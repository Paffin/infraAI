{
 "id": "rag-llm",
 "name": {
  "ru": "RAG-ассистент: LLM на GPU и векторная БД",
  "en": "RAG assistant: LLM on GPUs and a vector database"
 },
 "description": {
  "ru": "Сервис оркестрации, Qdrant на трёх AZ, vLLM на пулах GPU в каждой зоне, семантический кэш, история диалогов в PostgreSQL, документы в объектном хранилище, SSO через Keycloak.",
  "en": "An orchestration service, Qdrant across three AZs, vLLM on GPU pools in every zone, a semantic cache, dialogue history in PostgreSQL, documents in object storage, SSO through Keycloak."
 },
 "badge": "AI",
 "tags": [
  "ai",
  "llm",
  "rag",
  "vector-db",
  "gpu",
  "ha"
 ],
