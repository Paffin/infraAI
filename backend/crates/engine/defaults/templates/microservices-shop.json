 "id": "microservices-shop",
 "name": {
  "ru": "Микросервисы: интернет-магазин на Kubernetes",
  "en": "Microservices: an online shop on Kubernetes"
 },
 "description": {
  "ru": "API-шлюз, каталог с OpenSearch, корзина на Redis, заказы на PostgreSQL и RabbitMQ, service mesh и наблюдаемость на трёх AZ. Каждый сервис переживает потерю зоны.",
  "en": "An API gateway, a catalog on OpenSearch, a cart on Redis, orders on PostgreSQL and RabbitMQ, a service mesh and observability across three AZs. Every service survives the loss of a zone."
 },
 "badge": "Shop",
 "tags": [
  "microservices",
  "kubernetes",
  "ecommerce",
  "mesh",
  "ha"
 ],
