   "ru": "Раундов доработки по замечаниям движка",
   "en": "Refine rounds from engine findings"
  },
  "help": {
   "ru": "Критичные замечания движка передаются модели для исправления до показа результата.",
   "en": "Critical engine findings are fed back to the model before showing the result."
  },
  "min": 0,
  "max": 3
 },
 {
  "key": "llm.autoFixRounds",
  "group": "llm",
  "type": "number",
  "default": 2,
  "label": {
   "ru": "Раундов автоисправлений движка",
   "en": "Engine auto-fix rounds"
  },
  "min": 0,
  "max": 5,
  "help": {
   "ru": "После ответа модели движок сам применяет безопасные механические исправления критичных замечаний (масштабирование, DCS, арбитр, роль, группа) — детерминированно и с повторной проверкой. 0 — выключено.",
   "en": "After the model answers, the engine applies safe mechanical fixes for critical findings (scaling, DCS, arbiter, role, group) — deterministically and re-verified. 0 — off."
  }
 },
 {
  "key": "llm.autoFixKinds",
  "group": "llm",
  "type": "string_list",
  "default": [
   "scale",
   "set_dcs",
   "add_witness",
   "set_role",
   "group"
