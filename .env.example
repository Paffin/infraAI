# Copy to .env and adjust. Everything here is read once at start; everything else (OpenRouter models,
# limits, rules, catalog, prompts …) is configured in the admin panel and stored in the database.

# --- required in production -------------------------------------------------------------------------------
# Both are EMPTY here on purpose: docker compose refuses to start without them, and the server refuses a placeholder. Do not type a
# made-up value; let `make .env` (deploy/init-env.sh) write this file with generated ones, or generate your own: openssl rand -hex 32
#
# APP_SECRET: signs sessions and encrypts secrets stored in the database (AES-256-GCM). At least 32 characters, identical on every
# replica. Changing it signs everybody out and makes stored secrets (the OpenRouter key) unreadable: enter them again.
APP_SECRET=
POSTGRES_PASSWORD=

# --- first start --------------------------------------------------------------------------------------------
# The first administrator, created at the first start only (changing these later changes nothing). `make .env` generates ADMIN_PASSWORD;
# left empty, a random one is generated and printed once to the log, and must be changed at the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Demo project on first start (sample data with deliberate flaws); set to false for a clean installation.
#SEED_DEMO_PROJECT=true

# --- optional -------------------------------------------------------------------------------------------------
# OpenRouter key. Can also be set (encrypted) in Admin → OpenRouter, which takes precedence.
OPENROUTER_API_KEY=
# Public port of the container
APP_PORT=8080
# Set to true when the site is served over HTTPS (Secure cookies) – always in production behind a TLS proxy
COOKIE_SECURE=false
# Trust X-Forwarded-For / X-Forwarded-Host from the reverse proxy
TRUST_PROXY=false
# Bearer token required by /metrics (empty = open; keep it internal)
METRICS_TOKEN=
